#!/bin/sh
# Sprachsteuerung lokal - Waechter, minuetlich.
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Nur die NORMALE Ausgabe wird unterdrueckt. Die Fehlerausgabe gehoert in
# die Startdatei des Plugins: ohne sie waeren ein fehlendes dienst.sh, ein
# gescheiterter Abstieg und eine CRLF-Shebang lautlos (REGELN_2).
#
# Den Protokollordner ZUERST anlegen (0.12.0). Die Umleitung "2>>" wird
# ausgewertet, BEVOR dienst.sh startet - und dienst.sh legt den Ordner erst
# selbst an. log/ liegt auf einer Ramdisk; fehlt der Ordner nach einem
# Neustart, scheitert die Umleitung, und die Schale fuehrt den Befehl gar
# nicht aus (dash, gemessen: Rueckgabe 2, dienst.sh lief nie). Der Waechter
# holte den Dienst dann nie zurueck. Laesst sich start.log trotzdem nicht
# schreiben, laeuft der Waechter ohne Fehlerprotokoll - lieber das als gar
# nicht.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
STARTLOG="REPLACELBPLOGDIR/start.log"
# 0.12.10 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.12.9 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
( : >>"$STARTLOG" ) 2>/dev/null || STARTLOG=/dev/null
# Gruppe 11 (0.12.7, Entwurf 3.5): zuerst der Waechter der Befehlsbruecke - er startet sie jede Minute, wenn
# "Befehle ueber MQTT annehmen" gesetzt ist, und haelt sie sonst an (befehlsbruecke.php --waechter: misst
# zustand.json, nie waehrend einer Aktualisierung, hoechstens alle 600 s ein Neustart). Kein Start in den
# Hakenskripten. Er steht VOR dem Waechter des Dienstes, der die Startsperre nimmt.
BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
[ -f "$BBSH" ] && /bin/bash "$BBSH" waechter >/dev/null 2>>"$STARTLOG"
"REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"$STARTLOG"
